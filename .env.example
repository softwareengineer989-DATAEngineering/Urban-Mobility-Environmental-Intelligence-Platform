# ============================================================
# Project 2 Environment Configuration
# ============================================================
#
# Copy this file to .env for local development.
# NEVER commit .env or real credentials.
#

# Application
PROJECT_NAME=urban-mobility-environmental-intelligence-platform
ENVIRONMENT=local
LOG_LEVEL=INFO

# AWS
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# NOAA
NOAA_API_TOKEN=

# OpenAQ
OPENAQ_API_KEY=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
